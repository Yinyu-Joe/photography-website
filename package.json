{
  "name": "yinyu-zhu-photography-archive",
  "private": true,
  "type": "module",
  "scripts": {
    "map:dots": "node scripts/generate-world-dots.mjs",
    "refresh:dimensions": "node scripts/generate-source-dimensions.mjs",
    "build": "node scripts/build-site.mjs",
    "build:fast": "SKIP_IMAGE_BUILD=1 node scripts/build-site.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "audit:images": "node scripts/audit-image-metadata.mjs",
    "lighthouse:local": "node scripts/run-lighthouse.mjs",
    "test": "npm run build:fast && npm run audit:site",
    "validate": "npm run build && npm run audit:site -- --release && npm run audit:images"
  }
}
